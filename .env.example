# --- LLM (never commit real values) ---
LLM_PROVIDER=stub            # stub | openai_compat
LLM_BASE_URL=                # e.g. provider's OpenAI-compatible /v1 endpoint
LLM_API_KEY=
LLM_MODEL=
PRICE_IN_PER_1K=0            # USD per 1k prompt tokens (for cost tracking)
PRICE_OUT_PER_1K=0
# --- Retrieval ---
CHROMA_PATH=./.chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_RETRIEVAL_SCORE=0.25
# --- Agent ---
PROMPTS_DIR=./prompts
REASONER_PROMPT=reasoner_v1
EXTRACTOR_PROMPT=extractor_v1
MAX_STEPS=8
MAX_TOOL_CALLS=8
RUN_TIMEOUT_S=60
# --- Stub-only demo switches ---
STUB_DELAY_S=0
STUB_BAD_CITATION=0          # 1 = inject a fabricated quote on the first attempt (demo item 6)
